{
  "id": "/",
  "name": "PeekaListing Marketplace",
  "short_name": "PeekaListing",
  "description": "Find cars, trusted dealers and automotive services across Zimbabwe.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#050914",
  "background_color": "#050914",
  "categories": ["shopping", "business", "lifestyle"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {
      "src": "/brand/peekalisting-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand/peekalisting-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/brand/peekalisting-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Search listings",
      "short_name": "Search",
      "description": "Browse Cars across Zimbabwe",
      "url": "/search",
      "icons": [{ "src": "/brand/peekalisting-binoculars.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Post a listing",
      "short_name": "Post",
      "description": "Create a new listing",
      "url": "/post",
      "icons": [{ "src": "/brand/peekalisting-binoculars.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Saved",
      "short_name": "Saved",
      "description": "Your saved listings",
      "url": "/saved",
      "icons": [{ "src": "/brand/peekalisting-binoculars.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Chats",
      "short_name": "Chats",
      "description": "Your conversations",
      "url": "/chats",
      "icons": [{ "src": "/brand/peekalisting-binoculars.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
}
